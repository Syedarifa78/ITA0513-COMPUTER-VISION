import cv2
import numpy as np

# Read the image
image = cv2.imread("input.jpg")

# Get image dimensions
height, width = image.shape[:2]

# Source points
src = np.float32([
    [50, 50],
    [width - 50, 50],
    [50, height - 50],
    [width - 50, height - 50]
])

# Destination points
dst = np.float32([
    [100, 100],
    [width - 100, 50],
    [50, height - 100],
    [width - 50, height - 50]
])

# Compute transformation matrix (DLT)
matrix = cv2.getPerspectiveTransform(src, dst)

# Apply transformation
output = cv2.warpPerspective(image, matrix, (width, height))

# Save output image
cv2.imwrite("dlt_output.jpg", output)

# Display images
cv2.imshow("Original Image", image)
cv2.imshow("DLT Transformation", output)

cv2.waitKey(0)
cv2.destroyAllWindows()
